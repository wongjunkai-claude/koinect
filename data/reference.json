    {
      "name": "Biblical Grammar",
      "entries": [
        {
          "chinese": "因为",
          "pinyin": "yīnwèi",
          "english": "because",
          "note": "Common in both speech and writing, but especially frequent in Scripture's explanatory clauses.",
          "taughtInLesson": null
        },
        {
          "chinese": "所以",
          "pinyin": "suǒyǐ",
          "english": "therefore / so",
          "note": "A very common connective introducing a conclusion — appears constantly in the Epistles' argument-building style.",
          "taughtInLesson": null
        },
        {
          "chinese": "如此",
          "pinyin": "rúcǐ",
          "english": "thus / in this way",
          "note": "A literary word for 'so/like this' — conversational Chinese would usually say 这样.",
          "taughtInLesson": null
        },
        {
          "chinese": "于是",
          "pinyin": "yúshì",
          "english": "thereupon / then",
          "note": "A formal connective marking the next event in a narrative sequence — very common in Old Testament storytelling.",
          "taughtInLesson": null
        },
        {
          "chinese": "并且",
          "pinyin": "bìngqiě",
          "english": "and moreover / also",
          "note": "A formal connective for adding a further point — more literary than a simple 也 or 还.",
