{
  "lessons": [
    {
      "id": 1,
      "title": "Greetings",
      "subtitle": "第一课 · Greeting people at church",
      "scenario": "You've just arrived at church on a Sunday morning. People are greeting each other warmly at the door.",
      "dialogue": [
        {
          "speaker": "Wei",
          "chinese": "你好！",
          "pinyin": "Nǐ hǎo!",
          "english": "Hello!"
        },
        {
          "speaker": "You",
          "chinese": "你好！早安！",
          "pinyin": "Nǐ hǎo! Zǎo ān!",
          "english": "Hello! Good morning!"
        },
        {
          "speaker": "Wei",
          "chinese": "欢迎来教会！",
          "pinyin": "Huānyíng lái jiàohuì!",
          "english": "Welcome to church!"
        },
        {
          "speaker": "You",
          "chinese": "谢谢你！",
          "pinyin": "Xièxie nǐ!",
          "english": "Thank you!"
        },
        {
          "speaker": "Wei",
          "chinese": "平安！",
          "pinyin": "Píng'ān!",
          "english": "Peace be with you!"
        },
        {
          "speaker": "You",
          "chinese": "平安！再见！",
          "pinyin": "Píng'ān! Zàijiàn!",
          "english": "Peace! See you later!"
        }
      ],
      "vocabulary": [
        {
          "chinese": "你好",
          "pinyin": "nǐ hǎo",
          "english": "hello",
          "note": "The most common everyday greeting."
        },
        {
          "chinese": "早安",
          "pinyin": "zǎo ān",
          "english": "good morning",
          "note": "Used before noon."
        },
        {
          "chinese": "欢迎",
          "pinyin": "huānyíng",
          "english": "welcome",
          "note": "Often heard from greeters at the door."
        },
        {
          "chinese": "教会",
          "pinyin": "jiàohuì",
          "english": "church",
          "note": "The community, not just the building."
        },
        {
          "chinese": "谢谢",
          "pinyin": "xièxie",
          "english": "thank you",
          "note": "Polite and warm, used often."
        },
        {
          "chinese": "平安",
          "pinyin": "píng'ān",
          "english": "peace",
          "note": "A common greeting among Singapore Protestant believers, often short for 主内平安 ('peace in the Lord')."
        },
        {
          "chinese": "再见",
          "pinyin": "zàijiàn",
          "english": "goodbye",
          "note": "Literally 'see again.'"
        }
      ],
      "quiz": [
        {
          "question": "How do you say \"hello\"?",
          "options": [
            "你好",
            "谢谢",
            "再见"
          ],
          "answer": "你好"
        },
        {
          "question": "What does 教会 mean?",
          "options": [
            "church",
            "morning",
            "peace"
          ],
          "answer": "church"
        },
        {
          "question": "How would a greeter welcome you at the door?",
          "options": [
            "欢迎",
            "谢谢",
            "早安"
          ],
          "answer": "欢迎"
        },
        {
          "question": "What does 平安 mean?",
          "options": [
            "peace",
            "goodbye",
            "hello"
          ],
          "answer": "peace"
        },
        {
          "question": "How do you say \"thank you\"?",
          "options": [
            "谢谢",
            "你好",
            "再见"
          ],
          "answer": "谢谢"
        }
      ],
      "challenge": "Greet one person in Chinese this week — even just \"你好\" or \"平安.\"",
      "stage": "Connect"
    },
