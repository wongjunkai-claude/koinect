    {
      "id": 5,
      "title": "Sunday Service",
      "subtitle": "第五课 · Following along in worship",
      "scenario": "The service is about to begin. An usher gives you a bulletin and a friend tells you what's coming up.",
      "dialogue": [
        {
          "speaker": "Usher",
          "chinese": "请坐，崇拜快开始了。",
          "pinyin": "Qǐng zuò, chóngbài kuài kāishǐ le.",
          "english": "Please sit, the service is about to start."
        },
        {
          "speaker": "You",
          "chinese": "谢谢。今天讲道是关于什么？",
          "pinyin": "Xièxie. Jīntiān jiǎngdào shì guānyú shénme?",
          "english": "Thanks. What's today's sermon about?"
        },
        {
          "speaker": "Friend",
          "chinese": "是关于恩典的。",
          "pinyin": "Shì guānyú ēndiǎn de.",
          "english": "It's about grace."
        },
        {
          "speaker": "You",
          "chinese": "太好了，我们先唱诗歌吗？",
          "pinyin": "Tài hǎo le, wǒmen xiān chàng shīgē ma?",
          "english": "Great, do we sing songs first?"
        },
        {
          "speaker": "Friend",
          "chinese": "对，然后祷告，再讲道。",
          "pinyin": "Duì, ránhòu dǎogào, zài jiǎngdào.",
          "english": "Yes, then prayer, then the sermon."
        }
